AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyRender6%, SPLITTER.I.TopologyRender6
; cable 6: "Splitter 6 Output" (recording)
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_WaveCapture6%,     SPLITTER.I.WaveCapture6
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_WaveCapture6%,     SPLITTER.I.WaveCapture6
AddInterface = %KSCATEGORY_CAPTURE%,  %KSNAME_WaveCapture6%,     SPLITTER.I.WaveCapture6
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_TopologyCapture6%, SPLITTER.I.TopologyCapture6
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyCapture6%, SPLITTER.I.TopologyCapture6

[SPLITTER_SA.NT.Services]
AddService = Splitter,0x00000002,Splitter_Service_Inst

[Splitter_Service_Inst]
DisplayName   = %Splitter.SvcDesc%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %13%\splitter.sys

[SPLITTER_SA.NT.HW]
AddReg = AUDIOHW.AddReg

[AUDIOHW.AddReg]
; FILE_DEVICE_SOUND
HKR,,DeviceType,0x10001,0x0000001D
; SDDL_DEVOBJ_SYS_ALL_ADM_RWX_WORLD_RWX_RES_RWX
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"

;======================================================
; WDF
;======================================================
[SPLITTER_SA.NT.Wdf]
KmdfService = Splitter, SPLITTER_SA_WdfSect
[SPLITTER_SA_WdfSect]
KmdfLibraryVersion = $KMDFVERSION$

