;======================================================
; SPLITTER_SA
;======================================================
[SPLITTER_SA.NT]
Include = ks.inf, wdmaudio.inf
Needs   = KS.Registration, WDMAUDIO.Registration
CopyFiles = SPLITTER_SA.CopyList
AddReg  = SPLITTER_SA.AddReg

[SPLITTER_SA.NT.Interfaces]
; cable 1: "Splitter 1" (playback)
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_WaveRender1%,     SPLITTER.I.WaveRender1
AddInterface = %KSCATEGORY_RENDER%,   %KSNAME_WaveRender1%,     SPLITTER.I.WaveRender1
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_WaveRender1%,     SPLITTER.I.WaveRender1
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_TopologyRender1%, SPLITTER.I.TopologyRender1
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyRender1%, SPLITTER.I.TopologyRender1
; cable 1: "Splitter 1 Output" (recording)
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_WaveCapture1%,     SPLITTER.I.WaveCapture1
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_WaveCapture1%,     SPLITTER.I.WaveCapture1
AddInterface = %KSCATEGORY_CAPTURE%,  %KSNAME_WaveCapture1%,     SPLITTER.I.WaveCapture1
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_TopologyCapture1%, SPLITTER.I.TopologyCapture1
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyCapture1%, SPLITTER.I.TopologyCapture1
; cable 2: "Splitter 2" (playback)
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_WaveRender2%,     SPLITTER.I.WaveRender2
AddInterface = %KSCATEGORY_RENDER%,   %KSNAME_WaveRender2%,     SPLITTER.I.WaveRender2
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_WaveRender2%,     SPLITTER.I.WaveRender2
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_TopologyRender2%, SPLITTER.I.TopologyRender2
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyRender2%, SPLITTER.I.TopologyRender2
; cable 2: "Splitter 2 Output" (recording)
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_WaveCapture2%,     SPLITTER.I.WaveCapture2
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_WaveCapture2%,     SPLITTER.I.WaveCapture2
AddInterface = %KSCATEGORY_CAPTURE%,  %KSNAME_WaveCapture2%,     SPLITTER.I.WaveCapture2
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_TopologyCapture2%, SPLITTER.I.TopologyCapture2
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyCapture2%, SPLITTER.I.TopologyCapture2
; cable 3: "Splitter 3" (playback)
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_WaveRender3%,     SPLITTER.I.WaveRender3
AddInterface = %KSCATEGORY_RENDER%,   %KSNAME_WaveRender3%,     SPLITTER.I.WaveRender3
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_WaveRender3%,     SPLITTER.I.WaveRender3
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_TopologyRender3%, SPLITTER.I.TopologyRender3
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyRender3%, SPLITTER.I.TopologyRender3
; cable 3: "Splitter 3 Output" (recording)
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_WaveCapture3%,     SPLITTER.I.WaveCapture3
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_WaveCapture3%,     SPLITTER.I.WaveCapture3
AddInterface = %KSCATEGORY_CAPTURE%,  %KSNAME_WaveCapture3%,     SPLITTER.I.WaveCapture3
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_TopologyCapture3%, SPLITTER.I.TopologyCapture3
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyCapture3%, SPLITTER.I.TopologyCapture3
; cable 4: "Splitter 4" (playback)
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_WaveRender4%,     SPLITTER.I.WaveRender4
AddInterface = %KSCATEGORY_RENDER%,   %KSNAME_WaveRender4%,     SPLITTER.I.WaveRender4
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_WaveRender4%,     SPLITTER.I.WaveRender4
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_TopologyRender4%, SPLITTER.I.TopologyRender4
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyRender4%, SPLITTER.I.TopologyRender4
; cable 4: "Splitter 4 Output" (recording)
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_WaveCapture4%,     SPLITTER.I.WaveCapture4
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_WaveCapture4%,     SPLITTER.I.WaveCapture4
AddInterface = %KSCATEGORY_CAPTURE%,  %KSNAME_WaveCapture4%,     SPLITTER.I.WaveCapture4
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_TopologyCapture4%, SPLITTER.I.TopologyCapture4
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyCapture4%, SPLITTER.I.TopologyCapture4
; cable 5: "Splitter 5" (playback)
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_WaveRender5%,     SPLITTER.I.WaveRender5
AddInterface = %KSCATEGORY_RENDER%,   %KSNAME_WaveRender5%,     SPLITTER.I.WaveRender5
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_WaveRender5%,     SPLITTER.I.WaveRender5
