AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyCapture5%, SPLITTER.I.TopologyCapture5
; cable 6: "Splitter 6" (playback)
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_WaveRender6%,     SPLITTER.I.WaveRender6
AddInterface = %KSCATEGORY_RENDER%,   %KSNAME_WaveRender6%,     SPLITTER.I.WaveRender6
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_WaveRender6%,     SPLITTER.I.WaveRender6
