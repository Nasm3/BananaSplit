;
; Splitter: six numbered virtual audio cables for BananaSplit.
;
; Cable N is two endpoints: "Splitter N" (a playback device apps play into)
; and "Splitter N Output" (a recording device; BananaSplit's input strip N
; records it).
;
; Derived from SimpleAudioSample.inx of Microsoft's Windows-driver-samples
; (Copyright (c) Microsoft Corporation, MS-PL; see LICENSE-MS-PL.txt).
; This file is a template: stampinf fills in $ARCH$ and $KMDFVERSION$ at
; build time. Keep the KSNAME_* strings in step with Filters\minipairs.h and
; the *NameGUID strings with Inc\endpoints.h.
;

[Version]
Signature   = "$Windows NT$"
Class       = MEDIA
Provider    = %ProviderName%
ClassGUID   = {4d36e96c-e325-11ce-bfc1-08002be10318}
DriverVer   = 10/25/2026,0.1.0.0
CatalogFile = splitter.cat
PnpLockDown = 1

[SourceDisksNames]
222 = %DiskName%,"",222

[SourceDisksFiles]
splitter.sys = 222

[Manufacturer]
%MfgName% = SPLITTER,NT$ARCH$.10.0...19041

; Windows 10 2004 (build 19041) and later.
[SPLITTER.NT$ARCH$.10.0...19041]
%SPLITTER_SA.DeviceDesc% = SPLITTER_SA, ROOT\Splitter

[DestinationDirs]
SPLITTER_SA.CopyList = 13 ; 13 = Package's DriverStore directory

;======================================================
; SPLITTER_SA
;======================================================
[SPLITTER_SA.CopyList]
splitter.sys

[SPLITTER_SA.AddReg]
HKR,,AssociatedFilters,,"wdmaud,swmidi,redbook"
HKR,,Driver,,splitter.sys

HKR,Drivers,SubClasses,,"wave,midi,mixer"

HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\midi\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv

HKR,Drivers\wave\wdmaud.drv,Description,,%SPLITTER_SA.DeviceDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%SPLITTER_SA.DeviceDesc%

; The endpoints' numbered names (see Inc\endpoints.h).

HKLM,%MediaCategories%\%Render1NameGUID%,Name,,%Render1Name%
HKLM,%MediaCategories%\%Render1NameGUID%,Display,1,00,00,00,00
HKLM,%MediaCategories%\%Capture1NameGUID%,Name,,%Capture1Name%
HKLM,%MediaCategories%\%Capture1NameGUID%,Display,1,00,00,00,00
HKLM,%MediaCategories%\%Render2NameGUID%,Name,,%Render2Name%
HKLM,%MediaCategories%\%Render2NameGUID%,Display,1,00,00,00,00
HKLM,%MediaCategories%\%Capture2NameGUID%,Name,,%Capture2Name%
HKLM,%MediaCategories%\%Capture2NameGUID%,Display,1,00,00,00,00
HKLM,%MediaCategories%\%Render3NameGUID%,Name,,%Render3Name%
HKLM,%MediaCategories%\%Render3NameGUID%,Display,1,00,00,00,00
HKLM,%MediaCategories%\%Capture3NameGUID%,Name,,%Capture3Name%
HKLM,%MediaCategories%\%Capture3NameGUID%,Display,1,00,00,00,00
HKLM,%MediaCategories%\%Render4NameGUID%,Name,,%Render4Name%
HKLM,%MediaCategories%\%Render4NameGUID%,Display,1,00,00,00,00
HKLM,%MediaCategories%\%Capture4NameGUID%,Name,,%Capture4Name%
HKLM,%MediaCategories%\%Capture4NameGUID%,Display,1,00,00,00,00
HKLM,%MediaCategories%\%Render5NameGUID%,Name,,%Render5Name%
HKLM,%MediaCategories%\%Render5NameGUID%,Display,1,00,00,00,00
HKLM,%MediaCategories%\%Capture5NameGUID%,Name,,%Capture5Name%
HKLM,%MediaCategories%\%Capture5NameGUID%,Display,1,00,00,00,00
HKLM,%MediaCategories%\%Render6NameGUID%,Name,,%Render6Name%
HKLM,%MediaCategories%\%Render6NameGUID%,Display,1,00,00,00,00
HKLM,%MediaCategories%\%Capture6NameGUID%,Name,,%Capture6Name%
HKLM,%MediaCategories%\%Capture6NameGUID%,Display,1,00,00,00,00

;======================================================
; render interfaces: cable 1
;======================================================
[SPLITTER.I.WaveRender1]
AddReg = SPLITTER.I.WaveRender1.AddReg

[SPLITTER.I.WaveRender1.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Render1Name%

[SPLITTER.I.TopologyRender1]
AddReg = SPLITTER.I.TopologyRender1.AddReg

[SPLITTER.I.TopologyRender1.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Render1Name%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
; Opt in to pull (event-driven) mode.
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1

