; cable 5: "Splitter 5 Output" (recording)
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_WaveCapture5%,     SPLITTER.I.WaveCapture5
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_WaveCapture5%,     SPLITTER.I.WaveCapture5
AddInterface = %KSCATEGORY_CAPTURE%,  %KSNAME_WaveCapture5%,     SPLITTER.I.WaveCapture5
